# PostgreSQL Database Connection (Local Development)
DATABASE_URL="postgresql://user:password@localhost:5432/grand_addis_db"

# Production MySQL Database Connection (Plesk / Remote Server)
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="your_plesk_db_username"
# DB_PASSWORD="your_plesk_db_password"
# DB_NAME="grandaddis_db"
# Or single MySQL URL:
# DATABASE_URL="mysql://dbuser:dbpassword@127.0.0.1:3306/grandaddis_db"

# Admin Authentication
ADMIN_SECRET_KEY="replace-with-at-least-16-char-secret-key"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-strong-password"

# SkinaPay Payment Gateway
SIKINA_SECRET_KEY="your-skina-secret-key"
SIKINA_WEBHOOK_SECRET="your-skina-webhook-secret"
SIKINA_BASE_URL="https://sandbox.sikinapay.com"
SIKINA_SUCCESS_REDIRECT_URL="http://localhost:3050/your-booking-detail"
SIKINA_FAILED_REDIRECT_URL="http://localhost:3050/rooms-reservation"
APP_BASE_URL="http://localhost:3050"
