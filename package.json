{
  "name": "grandaddishotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3050",
    "dev:https": "next dev -p 3050 --experimental-https",
    "prebuild": "node scripts/generate.mjs",
    "build": "next build --webpack",
    "deploy": "npm run setup && npm run build",
    "start": "next start",
    "start:server": "node server.js",
    "test": "node scripts/test-endpoints.mjs",
    "generate": "node scripts/generate.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:mysql": "node scripts/migrate-mysql.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:mysql": "node scripts/seed-mysql.mjs",
    "seed:postgres": "node scripts/seed-db.mjs",
    "setup": "node scripts/setup-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:mysql": "node scripts/migrate-mysql.mjs",
    "db:push": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:mysql": "node scripts/seed-mysql.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:status": "node scripts/db-status.mjs",
    "cpanel:setup": "node scripts/setup-db.mjs",
    "cpanel:migrate": "node scripts/migrate.mjs",
    "cpanel:status": "node scripts/db-status.mjs",
    "plesk:setup": "node scripts/setup-db.mjs",
    "plesk:build": "node scripts/setup-db.mjs && next build --webpack",
    "prisma:generate": "node scripts/generate.mjs",
    "prisma:push": "node scripts/migrate.mjs",
    "prisma:emit": "prisma contract emit",
    "prisma:sign": "prisma db sign --yes",
    "prisma:infer": "prisma contract infer --db $DATABASE_URL --output ./src/prisma/contract.prisma --yes"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "prisma": "8.0.0-rc.20"
  }
}
